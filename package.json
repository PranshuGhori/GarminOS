{
  "name": "garminos",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "npm run db:push",
    "dev": "next dev -H 127.0.0.1",
    "dev:lan": "npm run db:push && cross-env DASHBOARD_ALLOW_LAN=1 next dev -H 0.0.0.0",
    "build": "next build",
    "prestart": "npm run db:push",
    "start": "next start -H 127.0.0.1",
    "db:push": "cross-env DATABASE_URL=file:./garmin.db prisma db push --skip-generate",
    "sync": "npm run db:push && tsx scripts/sync.ts",
    "remap": "tsx scripts/remap.ts",
    "seed:mock": "cross-env DATABASE_URL=file:./mock.db prisma db push --skip-generate && cross-env GARMIN_MOCK=1 tsx scripts/seed-mock.ts",
    "dev:mock": "cross-env GARMIN_MOCK=1 next dev -H 127.0.0.1 -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "cross-env DATABASE_URL=file:./test.db prisma db push --skip-generate && cross-env GARMIN_DB_FILE=test.db tsx --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fflate": "^0.8.3",
    "fit-file-parser": "^6.2.7",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
