# Create a key at https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# Optional
# UNITS=imperial            # override the unit system from your Garmin profile (metric | imperial)
# SYNC_INTERVAL_HOURS=6     # background sync cadence; 0 disables
# SYNC_BACKFILL_DAYS=730    # how far back the first sync reaches
# GARMIN_MIN_GAP_MS=350     # minimum spacing between Garmin requests
